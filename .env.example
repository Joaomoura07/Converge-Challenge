# =============================================================================
# Copie para .env e preencha:  cp .env.example .env
# NUNCA faça commit do .env (já está no .gitignore).
# Cada integrante usa a PRÓPRIA chave Featherless (US$ 25 cada).
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_ENV=development            # development | production
LOG_LEVEL=INFO
API_PORT=8000

# --- LLM Gateway: Featherless (API compatível com OpenAI) ---------------------
FEATHERLESS_API_KEY=fw-xxxxxxxxxxxxxxxxxxxxxxxx
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# Modelo principal (raciocínio, tool calling, tarefas difíceis)
FEATHERLESS_MODEL=zai-org/GLM-5.2
# Modelo barato p/ geração simples / classificação
FEATHERLESS_MODEL_FAST=google/gemma-4-31B-it
# Reserva automática quando o principal devolve 400 (frio/sem suporte) ou 503.
# Qwen 3 tem tool calling nativo documentado pela Featherless.
FEATHERLESS_MODEL_FALLBACK=Qwen/Qwen3-32B
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3              # retry automático em 429/5xx (503 = modelo frio)
AGENT_MAX_STEPS=8              # limite de iterações do loop do agente

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Backend: service_role key (ignora RLS). Nunca exponha no front-end.
SUPABASE_KEY=eyJhbGciOi...

# --- Langfuse (tracing / observabilidade) ------------------------------------
# false = desliga o tracing (a API funciona igual). Sem chaves reais, já desliga sozinho.
LANGFUSE_ENABLED=true
# Chaves reais: Langfuse -> seu projeto -> Settings -> API Keys (~40 caracteres cada)
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
# Cloud EU: https://cloud.langfuse.com | Cloud US: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
