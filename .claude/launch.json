{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "previa-fatia-b",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "ui-fatia-b",
        "run",
        "dev"
      ],
      "port": 5174
    },
    {
      "name": "orca-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "orca-frontend-verif",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set NEXT_DIST_DIR=.next-verif&& npm --prefix frontend run dev -- -p 3110"
      ],
      "port": 3110
    }
  ]
}
